{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "This is a auth service for the mirco-service pizza shop project.",
  "homepage": "https://github.com/marufkhan20/pizzashop-auth-service#readme",
  "bugs": {
    "url": "https://github.com/marufkhan20/pizzashop-auth-service/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marufkhan20/pizzashop-auth-service.git"
  },
  "license": "ISC",
  "author": "Rashedul Islam Maruf",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=dev tsx watch src/server.ts",
    "format:fix": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll --runInBand",
    "prepare": "husky",
    "start": "tsx src/index.ts",
    "migration:generate": "node scripts/generateMigration.js",
    "migration:run": "typeorm-ts-node-esm migration:run",
    "migration:create": "typeorm-ts-node-esm migration:create"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-validator": "^2.20.33",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/winston": "^2.4.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "mock-jwks": "^3.3.5",
    "msw": "^2.15.0",
    "prettier": "3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.ts": [
      "npm run format:fix",
      "npm run lint:fix"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "express-validator": "^7.3.2",
    "http-errors": "^2.0.1",
    "inversify": "^8.2.3",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rsa-pem-to-jwk": "^1.1.3",
    "supertest": "^7.2.2",
    "typeorm": "1.1.0",
    "winston": "^3.19.0"
  }
}
